<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ======== État ======== -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Activer la protection" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Autoriser notifications et contacts" />

        <Button
            android:id="@+id/btnExpect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- ======== Mode ======== -->
        <TextView
            style="@style/Section"
            android:text="Que faire d'un appel indésirable ?" />

        <Switch
            android:id="@+id/swSilence"
            style="@style/Rule"
            android:text="Mode doux : l'appel arrive en silence (tu peux encore décrocher). Désactivé = raccroché automatiquement." />

        <!-- ======== Règles ======== -->
        <TextView
            style="@style/Section"
            android:text="Ce qui est considéré comme indésirable" />

        <Switch
            android:id="@+id/swFr"
            style="@style/Rule"
            android:text="Préfixes de démarchage officiels France (+33 162, 163, 270, 271, 377, 378, 424, 425, 568, 569, 948, 949 et Outre-mer)" />

        <Switch
            android:id="@+id/swSpoof"
            style="@style/Rule"
            android:text="Numéros signalés comme usurpés par l'opérateur" />

        <Switch
            android:id="@+id/swHidden"
            style="@style/Rule"
            android:text="Numéros masqués" />

        <Switch
            android:id="@+id/swStrict"
            style="@style/Rule"
            android:text="Mode strict : tous les numéros absents de mes contacts" />

        <Switch
            android:id="@+id/swRepeat"
            style="@style/Rule"
            android:text="Laisser passer si le même numéro rappelle dans les 3 minutes (urgence)" />

        <TextView
            style="@style/Hint"
            android:text="Tes contacts et ta liste blanche sonnent toujours normalement." />

        <!-- ======== En ligne ======== -->
        <TextView
            style="@style/Section"
            android:text="Vérification en ligne" />

        <Switch
            android:id="@+id/swOnline"
            style="@style/Rule"
            android:text="Consulter la base communautaire PhoneBlock pour les numéros inconnus" />

        <Switch
            android:id="@+id/swAggressive"
            style="@style/Rule"
            android:text="Plus sévère : bloquer dès 1 signalement (sinon à partir de 3)" />

        <TextView
            style="@style/Hint"
            android:text="Seuls les numéros absents de tes contacts sont envoyés à phoneblock.net. Si la base ne répond pas en 2,5 s, le téléphone sonne normalement." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etToken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Clé API PhoneBlock (facultative)"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK" />
        </LinearLayout>

        <!-- ======== Annuaire inversé ======== -->
        <TextView
            style="@style/Section"
            android:text="Annuaire inversé" />

        <Switch
            android:id="@+id/swReverse"
            style="@style/Rule"
            android:text="Afficher le nom de l'appelant (annuaire tel.search.ch pour la Suisse, Google Maps pour les entreprises de tous pays)" />

        <TextView
            style="@style/Hint"
            android:text="Sans clé Google, la notification propose « Qui est-ce ? » : une recherche web du numéro en un tap." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearchKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Clé tel.search.ch (facultative)"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnSearchKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="Clé Google Maps Platform (Places API) : affiche le nom et la note Google des entreprises qui t'appellent. 1 000 recherches gratuites par mois, payant au-delà." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGoogleKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Clé Google (facultative)"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnGoogleKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OK" />
        </LinearLayout>

        <!-- ======== Liste noire ======== -->
        <TextView
            style="@style/Section"
            android:text="Ma liste noire" />

        <TextView
            style="@style/Hint"
            android:text="Un numéro complet, ou un début de numéro au format international pour bloquer toute une plage (ex. +44, +225, +33162)." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBlack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Numéro ou préfixe"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAddBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ======== Liste blanche ======== -->
        <TextView
            style="@style/Section"
            android:text="Ma liste blanche (toujours autorisés)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWhite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Numéro ou préfixe"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAddWhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajouter" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ======== Tester ======== -->
        <TextView
            style="@style/Section"
            android:text="Tester un numéro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ex. 01 62 12 34 56"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tester" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <!-- ======== Historique ======== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Section"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="Appels filtrés" />

            <Button
                android:id="@+id/btnClear"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Effacer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
