<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ======== État ======== -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatusDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnActivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_activate" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_permissions" />

        <Button
            android:id="@+id/btnExpect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- ======== Mode ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_mode" />

        <Switch
            android:id="@+id/swSilence"
            style="@style/Rule"
            android:text="@string/rule_silence" />

        <!-- ======== Règles ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_rules" />

        <Switch
            android:id="@+id/swOfficial"
            style="@style/Rule"
            android:text="@string/rule_official" />

        <Switch
            android:id="@+id/swSpoof"
            style="@style/Rule"
            android:text="@string/rule_spoof" />

        <Switch
            android:id="@+id/swHidden"
            style="@style/Rule"
            android:text="@string/rule_hidden" />

        <Switch
            android:id="@+id/swStrict"
            style="@style/Rule"
            android:text="@string/rule_strict" />

        <Switch
            android:id="@+id/swRepeat"
            style="@style/Rule"
            android:text="@string/rule_repeat" />

        <TextView
            style="@style/Hint"
            android:text="@string/hint_always" />

        <!-- ======== En ligne ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_online" />

        <Switch
            android:id="@+id/swOnline"
            style="@style/Rule"
            android:text="@string/rule_online" />

        <Switch
            android:id="@+id/swAggressive"
            style="@style/Rule"
            android:text="@string/rule_aggressive" />

        <TextView
            style="@style/Hint"
            android:text="@string/hint_online" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etToken"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_token"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ok" />
        </LinearLayout>

        <!-- ======== Annuaire inversé ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_reverse" />

        <Switch
            android:id="@+id/swReverse"
            style="@style/Rule"
            android:text="@string/rule_reverse" />

        <TextView
            style="@style/Hint"
            android:text="@string/hint_reverse_web" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etSearchKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_searchch"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnSearchKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ok" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="@string/hint_google_info" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etGoogleKey"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_google"
                android:inputType="textPassword" />

            <Button
                android:id="@+id/btnGoogleKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ok" />
        </LinearLayout>

        <!-- ======== Liste noire ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_black" />

        <TextView
            style="@style/Hint"
            android:text="@string/hint_black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etBlack"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_number"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAddBlack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listBlack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ======== Liste blanche ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWhite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_number"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAddWhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/listWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ======== Tester ======== -->
        <TextView
            style="@style/Section"
            android:text="@string/sec_test" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_test"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp" />

        <!-- ======== Historique ======== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Section"
                android:layout_width="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="@string/sec_history" />

            <Button
                android:id="@+id/btnClear"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:text="@string/hint_history" />

        <Button
            android:id="@+id/btnCallLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_calllog" />

        <LinearLayout
            android:id="@+id/waveBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/listHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
